    <template id="furniture_about_us" name="About Luma Home">
        <t t-call="website.layout">
            <t t-set="title">About Us | Luma Home</t>
            <main id="wrap" class="luma-inner-page luma-about-page">
                <section class="luma-inner-hero"><div class="container"><p class="luma-eyebrow">Our story</p><h1>Furniture for<br/><em>living fully.</em></h1><p>Luma Home began with a simple belief: the things around us should make daily life feel better.</p></div></section>
                <section class="luma-about-story"><div class="container luma-about-grid"><div class="luma-about-art"><div class="luma-about-sun"></div><div class="luma-about-table"></div><div class="luma-about-flower"></div></div><div><p class="luma-eyebrow">Why Luma</p><h2>Beautiful is only the beginning.</h2><p>We design and curate furniture with a warm, modern point of view. Pieces that look considered, feel comfortable, and hold up to the beautiful mess of everyday life.</p><p>Our work is rooted in thoughtful proportion, natural textures, and personal service. No pressure, no unnecessary complexity — just good pieces and the people who help you find them.</p></div></div></section>
                <section class="luma-values"><div class="container"><p class="luma-eyebrow">What we believe</p><div class="luma-value-grid"><div><strong>01</strong><h3>Purpose over noise</h3><p>Every detail should earn its place.</p></div><div><strong>02</strong><h3>Warmth over perfection</h3><p>A home should welcome real life.</p></div><div><strong>03</strong><h3>Long-term thinking</h3><p>Choose fewer things, chosen well.</p></div></div></div></section>
                <section class="luma-about-cta"><div class="container"><h2>Come see what<br/><em>feels right.</em></h2><a href="/contactus" class="btn luma-btn luma-btn-dark">Meet the Luma team &#8599;</a></div></section>
            </main>
        </t>
    </template>

