            <main id="wrap" class="luma-homepage">
                <nav class="luma-nav" aria-label="Main navigation"><div class="container luma-nav-inner"><a class="luma-logo" href="/">LUMA<span>HOME</span></a><div class="luma-nav-links"><a href="/about-us">About us</a><a href="/products">Products</a><a href="/services">Services</a><a href="/product">Product</a><a href="#legal">Legal</a><a class="luma-nav-contact" href="/contactus">Contact us <span>&#8599;</span></a></div></div></nav>
