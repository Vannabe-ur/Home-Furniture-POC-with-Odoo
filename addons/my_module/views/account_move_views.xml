<odoo>
    <record id="view_account_move_boq_details" model="ir.ui.view">
        <field name="name">account.move.form.boq.details</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="boq_id" readonly="1" invisible="not boq_id"/>
                <field name="boq_margin" widget="percentage" readonly="1" invisible="not boq_id"/>
                <field name="boq_margin_cost" string="BoQ Margin" widget="monetary"
                       options="{'currency_field': 'currency_id'}" readonly="1" invisible="not boq_id"/>
                <field name="boq_total_cost" string="BoQ Total Cost" widget="monetary"
                       options="{'currency_field': 'currency_id'}" readonly="1" invisible="not boq_id"/>
            </xpath>
        </field>
    </record>
</odoo>
