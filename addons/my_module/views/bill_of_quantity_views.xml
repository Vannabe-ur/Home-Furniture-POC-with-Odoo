<odoo>
    <record id="view_bill_of_quantity_list" model="ir.ui.view">
        <field name="name">client.bill_of_quantity.list</field>
        <field name="model">client.bill_of_quantity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="request_id"/><field name="partner_id"/>
                <field name="priority" widget="priority"/><field name="version"/>
                <field name="responsible_id"/><field name="design_manager_id"/>
                <field name="total_cost"/><field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_bill_of_quantity_form" model="ir.ui.view">
        <field name="name">client.bill_of_quantity.form</field>
        <field name="model">client.bill_of_quantity</field>
        <field name="arch" type="xml">
            <form string="Bill of Quantities">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger" invisible="state in ('done', 'cancel')" confirm="Are you sure you want to cancel this BoQ?"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1><field name="priority" widget="priority" class="oe_inline"/></div>
                    <group>
                        <group string="Request Details">
                            <field name="request_id" readonly="state != 'draft'"/><field name="partner_id"/>
                            <field name="phone"/><field name="email"/><field name="project_id"/>
                            <field name="unit_code" readonly="state != 'draft'"/><field name="product_type"/>
                        </group>
                        <group string="BoQ Details">
                            <field name="create_date" string="Created on" readonly="1"/><field name="version" readonly="state != 'draft'"/>
                            <field name="revision_date" readonly="state != 'draft'"/><field name="responsible_id" readonly="state != 'draft'"/>
                            <field name="design_manager_id"/><field name="max_budget" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/><field name="attachment" filename="attachment_filename" readonly="state != 'draft'"/>
                            <field name="attachment_filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook><page string="BoQ Items">
                        <field name="line_ids" readonly="state == 'done'">
                            <list editable="bottom">
                                <field name="date"/><field name="job_type"/><field name="product_id"/>
                                <field name="description"/><field name="quantity" string="Planned Qty"/>
                                <field name="uom_id"/><field name="sale_price"/><field name="subtotal" readonly="1"/>
                            </list>
                        </field>
                    </page></notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="margin" widget="percentage"/><field name="total_materials_cost"/>
                        <field name="total_service_cost"/><field name="total_labor_cost"/>
                        <field name="total_cost" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_bill_of_quantity" model="ir.actions.act_window">
        <field name="name">BoQ</field><field name="res_model">client.bill_of_quantity</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_bill_of_quantity" name="Bill of Quantities" parent="menu_client_ticket_root" action="action_bill_of_quantity" groups="base.group_system,my_module.group_client_ticket_manager,my_module.group_client_ticket_designer"/>
</odoo>
