<odoo>
    <record id="view_partner_form_ticket_button" model="ir.ui.view">
        <field name="name">res.partner.form.client.ticket</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_tickets" icon="fa-ticket">
                        <field name="ticket_count" widget="statinfo" string="Design Requests"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
