<odoo>
    <!-- Kanban View-->
    <record id="view_client_ticket_kanban" model="ir.ui.view">
        <field name="name">design.request.kanban</field>
        <field name="model">design.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="design_manager_id"/>
                <field name="priority"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="text-muted"><field name="ticket_ref"/></div>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong><field name="ticket_ref"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div>
                                <field name="partner_id"/>
                            </div>
                            <div t-if="record.design_manager_id.value">
                                Assigned Manager: <field name="design_manager_id"/>
                            </div>
                            <div t-if="record.require_date.value">
                                Required Date: <field name="require_date"/>
                            </div>
                            <div t-if="record.is_overdue.raw_value" class="text-danger">
                                <strong>Overdue</strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List (Tree) View -->
    <record id="view_client_ticket_list" model="ir.ui.view">
        <field name="name">design.request.list</field>
        <field name="model">design.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="ticket_ref"/>                
                <field name="partner_id"/>
                <field name="request_type"/>
                <field name="require_date"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('submitted', 'approved')"
                       decoration-warning="state in ('assigned', 'in_progress')"
                       decoration-success="state in ('completed', 'closed')"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_client_ticket_form" model="ir.ui.view">
        <field name="name">design.request.form</field>
        <field name="model">design.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submitted" type="object" string="Submitted"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approved" type="object" string="Approved"
                            invisible="state != 'submitted'" class="oe_highlight"/>
                    <button name="action_assign" type="object" string="Assigned"
                            invisible="state != 'approved'" class="oe_highlight"/>
                    <button name="action_start" type="object" string="In Progress"
                            invisible="state != 'assigned'" class="oe_highlight"/>
                    <button name="action_complete" type="object" string="Completed"
                            invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_close" type="object" string="Closed"
                            invisible="state != 'completed'" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('closed', 'cancel')" class="btn-danger" confirm="Are you sure you want to cancel this design request?"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state in ('draft', 'closed', 'cancel')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,assigned,in_progress,completed,closed"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_boqs" type="object" class="oe_stat_button" icon="fa-list-alt" invisible="boq_count == 0">
                            <field name="boq_count" widget="statinfo" string="BoQs"/>
                        </button>
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button" icon="fa-usd" invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sales"/>
                        </button>
                    </div>
                    <widget name="web_ribbon"
                            text="🔒 Closed"
                            bg_color="text-bg-success"
                            invisible="state != 'closed'"/>
                    <widget name="web_ribbon"
                            text="Cancelled"
                            bg_color="text-bg-danger"
                            invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="ticket_ref" readonly="1"/>
                        </h1>
                        <field name="priority" widget="priority" class="oe_inline"
                               readonly="state in ('closed', 'cancel')"/>
                    </div>
                    <group>
                        <group string="Request Details">
                            <field name="partner_id"
                                   widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                   options="{'always_reload': True}"
                                   readonly="state in ('closed', 'cancel')"/>
                            <field name="request_type" readonly="state in ('closed', 'cancel')"/>
                            <field name="interior_design_area" string="Design Area"
                                   readonly="state in ('closed', 'cancel')"
                                   invisible="request_type not in (False, 'interior')"
                                   placeholder="Select an interior design area"/>
                            <field name="exterior_design_area" string="Design Area"
                                   readonly="state in ('closed', 'cancel')"
                                   invisible="request_type != 'exterior'"
                                   placeholder="Select an exterior design area"/>
                            <field name="outdoor_design_area" string="Design Area"
                                   readonly="state in ('closed', 'cancel')"
                                   invisible="request_type != 'outdoor'"
                                   placeholder="Select an outdoor design area"/>
                            <field name="phone" readonly="state in ('closed', 'cancel')"/>
                            <field name="email" readonly="state in ('closed', 'cancel')"/>
                            <field name="max_budget" readonly="state in ('closed', 'cancel')"/>
                            <field name="create_date" string="Created on" readonly="1"/>
                        </group>
                        <group string="Assignment">
                            <field name="requester_id" readonly="state in ('closed', 'cancel')"/>
                            <field name="design_manager_id" readonly="state in ('closed', 'cancel')"/>
                            <field name="designer_id" invisible="state in ('draft', 'submitted')" readonly="state in ('closed', 'cancel')"/>
                            <field name="require_date" readonly="state in ('closed', 'cancel')"/>
                            <field name="is_overdue"/>
                            <field name="boq_id"
                                   context="{'default_request_id': id}"
                                   readonly="state != 'in_progress' or state in ('closed', 'cancel')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Add a description..." readonly="state in ('closed', 'cancel')"/>
                        </page>
                        <page string="Audit History">
                            <group string="Workflow History">
                                <group>
                                    <field name="submitted_at"/>
                                    <field name="submitted_by"/>
                                    <field name="approved_at"/>
                                    <field name="approved_by"/>
                                    <field name="assigned_at"/>
                                    <field name="assigned_by"/>
                                </group>
                                <group>
                                    <field name="started_at"/>
                                    <field name="started_by"/>
                                    <field name="completed_at"/>
                                    <field name="completed_by"/>
                                    <field name="closed_at"/>
                                    <field name="closed_by"/>
                                    <field name="cancelled_at"/>
                                    <field name="cancelled_by"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Calenda View -->
    <record id="view_client_ticket_calendar" model="ir.ui.view">
        <field name="name">design.request.calendar</field>
        <field name="model">design.request</field>
        <field name="arch" type="xml">
            <calendar string="Design Requests" date_start="require_date" color="priority">
                <field name="priority"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="create_date"/>
                <field name="require_date"/>
            </calendar>
        </field>
    </record>

    <!-- Pivot table / Analytic View -->
    <record id="view_client_ticket_pivot" model="ir.ui.view">
        <field name="name">design.request.pivot</field>
        <field name="model">design.request</field>
        <field name="arch" type="xml">
            <pivot string="Design Requests Analysis" sample="1">
                <field name="state" type="row"/>
                <field name="design_manager_id" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- Graph / Analytic View -->
    <record id="view_client_ticket_graph" model="ir.ui.view">
        <field name="name">design.request.graph</field>
        <field name="model">design.request</field>
        <field name="arch" type="xml">
            <graph string="Design Requests" type="pie" disable_linking="True">
                <field name="state"/>
            </graph>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_client_ticket" model="ir.actions.act_window">
        <field name="name">Design Requests</field>
        <field name="res_model">design.request</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph</field>
    </record>
    <!-- Menu Items -->
    <menuitem id="menu_client_ticket_root"
              name="Design Requests"
              groups="base.group_system,my_module.group_client_ticket_manager,my_module.group_client_ticket_designer"/>
    <menuitem id="menu_client_ticket"
              name="Design Requests"
              parent="menu_client_ticket_root"
              action="action_client_ticket"
              groups="base.group_system,my_module.group_client_ticket_manager,my_module.group_client_ticket_designer"/>
</odoo>
