<odoo>
    <data noupdate="1">
        <record id="mail_template_boq_submitted" model="mail.template">
            <field name="name">BoQ: Submitted for Approval</field>
            <field name="model_id" ref="model_client_bill_of_quantity"/>
            <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.design_manager_id.email or '' }}</field>
            <field name="subject">BoQ requires approval: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>A Bill of Quantity is waiting for your approval.</p>
                    <p><strong>BoQ:</strong> <t t-out="object.name"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Version:</strong> <t t-out="object.version"/></p>
                    <p>Please review the BoQ and approve or reject it.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_boq_approved" model="mail.template">
            <field name="name">BoQ: Approved</field>
            <field name="model_id" ref="model_client_bill_of_quantity"/>
            <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.responsible_id.email or '' }}</field>
            <field name="subject">BoQ approved: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Your Bill of Quantity has been approved.</p>
                    <p><strong>BoQ:</strong> <t t-out="object.name"/></p>
                    <p><strong>Version:</strong> <t t-out="object.version"/></p>
                    <p>You may now send it to the customer for review.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_boq_rejected" model="mail.template">
            <field name="name">BoQ: Rejected with Feedback</field>
            <field name="model_id" ref="model_client_bill_of_quantity"/>
            <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.responsible_id.email or '' }}</field>
            <field name="subject">BoQ needs revision: {{ object.name }} v{{ object.version }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Your Bill of Quantity was rejected and returned to Draft for revision.</p>
                    <p><strong>BoQ:</strong> <t t-out="object.name"/></p>
                    <p><strong>New Version:</strong> <t t-out="object.version"/></p>
                    <p><strong>Revision Date:</strong> <t t-out="object.revision_date"/></p>
                    <p><strong>Manager Feedback:</strong></p>
                    <p><t t-out="object.rejection_feedback"/></p>
                    <p>Update the BoQ and resubmit it for approval.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_boq_customer_review" model="mail.template">
            <field name="name">BoQ: Customer Review</field>
            <field name="model_id" ref="model_client_bill_of_quantity"/>
            <field name="email_from">{{ user.company_id.email_formatted or user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.partner_id.email or object.email or '' }}</field>
            <field name="subject">BoQ ready for your review: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
                    <p>The Bill of Quantity for your design request is ready for your review.</p>
                    <p><strong>BoQ:</strong> <t t-out="object.name"/></p>
                    <p><strong>Version:</strong> <t t-out="object.version"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr>
                                <th style="text-align: left; border-bottom: 1px solid #ddd;">Description</th>
                                <th style="text-align: right; border-bottom: 1px solid #ddd;">Quantity</th>
                                <th style="text-align: right; border-bottom: 1px solid #ddd;">Price</th>
                                <th style="text-align: right; border-bottom: 1px solid #ddd;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.line_ids" t-as="line">
                                <tr>
                                    <td style="border-bottom: 1px solid #eee;"><t t-out="line.description or line.product_id.display_name or ''"/></td>
                                    <td style="text-align: right; border-bottom: 1px solid #eee;"><t t-out="line.quantity"/></td>
                                    <td style="text-align: right; border-bottom: 1px solid #eee;"><t t-out="line.sale_price"/></td>
                                    <td style="text-align: right; border-bottom: 1px solid #eee;"><t t-out="line.subtotal"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <p><strong>Total Cost:</strong> <t t-out="object.total_cost"/></p>
                    <p>Please review the attached design file and confirm your approval with our team.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
