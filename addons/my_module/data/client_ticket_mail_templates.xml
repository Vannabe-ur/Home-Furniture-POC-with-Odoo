<odoo>
    <data noupdate="1">
        <record id="mail_template_ticket_submitted" model="mail.template">
            <field name="name">Client Ticket: Submitted</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.design_manager_id.email or '' }}</field>
            <field name="subject">New ticket submitted: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>A new client ticket requires your review.</p>
                    <p><strong>Ticket:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Request type:</strong> <t t-out="object.request_type or 'Not set'"/></p>
                    <p>Please review and approve the ticket, then assign it to a Designer.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_assigned" model="mail.template">
            <field name="name">Client Ticket: Assigned to Designer</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.designer_id.email or '' }}</field>
            <field name="subject">Ticket assigned to you: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>A client ticket has been assigned to you.</p>
                    <p><strong>Ticket:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Required date:</strong> <t t-out="object.require_date or 'Not set'"/></p>
                    <p>Please start working on this task.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_overdue" model="mail.template">
            <field name="name">Client Ticket: Overdue Reminder</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.design_manager_id.email or '' }}</field>
            <field name="subject">Overdue ticket: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>This client ticket is overdue.</p>
                    <p><strong>Ticket:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Required date:</strong> <t t-out="object.require_date or 'Not set'"/></p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_completed" model="mail.template">
            <field name="name">Client Ticket: Completed</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.design_manager_id.email or '' }}</field>
            <field name="subject">Ticket completed - ready to close: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The client ticket has been completed and is ready for project closure.</p>
                    <p><strong>Ticket:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Designer:</strong> <t t-out="object.designer_id.name or 'Not assigned'"/></p>
                    <p><strong>Completed at:</strong> <t t-out="object.completed_at or ''"/></p>
                    <p>Please review the completed work and close the project if everything is ready.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
