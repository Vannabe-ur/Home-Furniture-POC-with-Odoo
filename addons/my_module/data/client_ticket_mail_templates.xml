<odoo>
    <data noupdate="1">
        <record id="mail_template_ticket_submitted" model="mail.template">
            <field name="name">Design Request: Submitted</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.design_manager_id.email or '' }}</field>
            <field name="subject">New design request submitted: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>A new design request requires your review.</p>
                    <p><strong>Design Request:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Request type:</strong> <t t-out="object.request_type or 'Not set'"/></p>
                    <p>Please review and approve the design request, then assign it to a Designer.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_assigned" model="mail.template">
            <field name="name">Design Request: Assigned to Designer</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.designer_id.email or '' }}</field>
            <field name="subject">Design request assigned to you: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>A design request has been assigned to you.</p>
                    <p><strong>Design Request:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Required date:</strong> <t t-out="object.require_date or 'Not set'"/></p>
                    <p>Please start working on this task.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_overdue" model="mail.template">
            <field name="name">Design Request: Overdue Reminder</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.design_manager_id.email or '' }}</field>
            <field name="subject">Overdue design request: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>This design request is overdue.</p>
                    <p><strong>Design Request:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Required date:</strong> <t t-out="object.require_date or 'Not set'"/></p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_completed" model="mail.template">
            <field name="name">Design Request: Completed</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.design_manager_id.email or '' }}</field>
            <field name="subject">Design request completed - ready to close: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>The design request has been completed and is ready for project closure.</p>
                    <p><strong>Design Request:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Designer:</strong> <t t-out="object.designer_id.name or 'Not assigned'"/></p>
                    <p><strong>Completed at:</strong> <t t-out="object.completed_at or ''"/></p>
                    <p>Please review the completed work and close the project if everything is ready.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_ticket_deadline_reminder" model="mail.template">
            <field name="name">Design Request: Deadline Reminder</field>
            <field name="model_id" ref="model_client_ticket"/>
            <field name="email_from">{{ user.email_formatted or '' }}</field>
            <field name="subject">Design request deadline is tomorrow: {{ object.ticket_ref }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>This is a deadline reminder for an unfinished design request.</p>
                    <p><strong>Design Request:</strong> <t t-out="object.ticket_ref"/></p>
                    <p><strong>Customer:</strong> <t t-out="object.partner_id.name"/></p>
                    <p><strong>Designer:</strong> <t t-out="object.designer_id.name or 'Not assigned'"/></p>
                    <p><strong>Design Manager:</strong> <t t-out="object.design_manager_id.name or 'Not assigned'"/></p>
                    <p><strong>Required date:</strong> <t t-out="object.require_date or 'Not set'"/></p>
                    <p>Please complete or review this design request before the deadline.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
