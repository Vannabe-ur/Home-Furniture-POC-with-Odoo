<odoo>
    <record id="ir_cron_notify_overdue_tickets" model="ir.cron">
        <field name="name">Notify overdue design requests</field>
        <field name="model_id" ref="model_client_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_email_assigned_overdue" model="ir.cron">
        <field name="name">Email assigned user for overdue design requests</field>
        <field name="model_id" ref="model_client_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_email_assigned_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
