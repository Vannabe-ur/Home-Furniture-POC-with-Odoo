<odoo>

    <!-- Category -->
    <record id="module_category_client_ticket" model="ir.module.category">
        <field name="name">Client Ticket</field>
        <field name="sequence">30</field>
    </record>

    <!-- Privilege -->
    <record id="privilege_client_ticket" model="res.groups.privilege">
        <field name="name">Client Ticket</field>
        <field name="category_id" ref="module_category_client_ticket"/>
        <field name="sequence">10</field>
    </record>

    <!-- User group -->
    <record id="group_client_ticket_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_client_ticket"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager group -->
    <record id="group_client_ticket_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_client_ticket"/>
        <field name="implied_ids"
               eval="[(4, ref('group_client_ticket_user'))]"/>
    </record>

    <!-- Users see only their assigned tasks -->
    <record id="rule_client_ticket_user_own_tasks" model="ir.rule">
        <field name="name">Users: Own Client Tickets</field>
        <field name="model_id" ref="model_client_ticket"/>
        <field name="domain_force">
            ['|',
                ('requester_id', '=', user.id),
                '|',
                '&amp;',
                ('design_manager_id', '=', user.id),
                ('state', '!=', 'draft'),
                '&amp;',
                ('designer_id', '=', user.id),
                ('state', 'in', ('approved','assigned', 'in_progress', 'completed', 'closed'))
            ]
        </field>
        <field name="groups"
               eval="[(4, ref('group_client_ticket_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Managers see all tasks -->
    <record id="rule_client_ticket_manager_all_tasks" model="ir.rule">
        <field name="name">Managers: All Client Tickets</field>
        <field name="model_id" ref="model_client_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('group_client_ticket_manager'))]"/>
    </record>

</odoo>