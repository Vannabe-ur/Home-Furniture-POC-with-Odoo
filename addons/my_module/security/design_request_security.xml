<odoo>

    <!-- Category -->
    <record id="module_category_client_ticket" model="ir.module.category">
        <field name="name">Design Request</field>
        <field name="sequence">30</field>
    </record>

    <!-- Privilege -->
    <record id="privilege_client_ticket" model="res.groups.privilege">
        <field name="name">Design Request</field>
        <field name="category_id" ref="module_category_client_ticket"/>
        <field name="sequence">10</field>
    </record>

    <!-- User group -->
    <record id="group_client_ticket_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_client_ticket"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Design Manager group -->
    <record id="group_client_ticket_manager" model="res.groups">
        <field name="name">Design Manager</field>
        <field name="privilege_id" ref="privilege_client_ticket"/>
        <field name="implied_ids"
               eval="[(4, ref('group_client_ticket_user'))]"/>
    </record>

    <!-- Designer group -->
    <record id="group_client_ticket_designer" model="res.groups">
        <field name="name">Designer</field>
        <field name="privilege_id" ref="privilege_client_ticket"/>
        <field name="sequence">20</field>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Disable the old rule from earlier module versions. -->
    <record id="rule_client_ticket_user_own_tasks" model="ir.rule">
        <field name="name">Users: Legacy Design Request Rule</field>
        <field name="model_id" ref="model_design_request"/>
        <field name="active" eval="False"/>
    </record>

    <!-- Administrators can access every design request -->
    <record id="rule_client_ticket_admin_all" model="ir.rule">
        <field name="name">Administrators: All Design Requests</field>
        <field name="model_id" ref="model_design_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Design Managers see submitted design requests assigned to them -->
    <record id="rule_client_ticket_manager_all_tasks" model="ir.rule">
        <field name="name">Design Managers: Assigned Design Requests</field>
        <field name="model_id" ref="model_design_request"/>
        <field name="domain_force">
            ['|',
             ('state', '=', 'draft'),
             '&amp;',
             ('design_manager_id', '=', user.id),
             ('state', 'in', ('submitted', 'approved', 'assigned', 'in_progress', 'completed', 'closed'))]
        </field>
        <field name="groups"
               eval="[(4, ref('group_client_ticket_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Designers see approved and later design requests assigned to them -->
    <record id="rule_client_ticket_designer_assigned" model="ir.rule">
        <field name="name">Designers: Assigned Design Requests</field>
        <field name="model_id" ref="model_design_request"/>
        <field name="domain_force">
            [('designer_id', '=', user.id),
             ('state', 'in', ('approved', 'assigned', 'in_progress', 'completed', 'closed'))]
        </field>
        <field name="groups"
               eval="[(4, ref('group_client_ticket_designer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- BoQs follow the Design Request assignment. -->
    <record id="rule_bill_of_quantity_manager_assigned" model="ir.rule">
        <field name="name">Design Managers: BoQs for Assigned Requests</field>
        <field name="model_id" ref="model_client_bill_of_quantity"/>
        <field name="domain_force">[('request_id.design_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_client_ticket_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bill_of_quantity_designer_assigned" model="ir.rule">
        <field name="name">Designers: BoQs for Assigned Requests</field>
        <field name="model_id" ref="model_client_bill_of_quantity"/>
        <field name="domain_force">[('request_id.designer_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_client_ticket_designer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_bill_of_quantity_line_manager_assigned" model="ir.rule">
        <field name="name">Design Managers: BoQ Lines for Assigned Requests</field>
        <field name="model_id" ref="model_client_bill_of_quantity_line"/>
        <field name="domain_force">[('boq_id.request_id.design_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_client_ticket_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bill_of_quantity_line_designer_assigned" model="ir.rule">
        <field name="name">Designers: BoQ Lines for Assigned Requests</field>
        <field name="model_id" ref="model_client_bill_of_quantity_line"/>
        <field name="domain_force">[('boq_id.request_id.designer_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_client_ticket_designer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bill_of_quantity_history_manager_assigned" model="ir.rule">
        <field name="name">Design Managers: BoQ History for Assigned Requests</field>
        <field name="model_id" ref="model_client_bill_of_quantity_history"/>
        <field name="domain_force">[('boq_id.request_id.design_manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_client_ticket_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bill_of_quantity_history_designer_assigned" model="ir.rule">
        <field name="name">Designers: BoQ History for Assigned Requests</field>
        <field name="model_id" ref="model_client_bill_of_quantity_history"/>
        <field name="domain_force">[('boq_id.request_id.designer_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_client_ticket_designer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Administrators can access every BoQ and its related records. -->
    <record id="rule_bill_of_quantity_admin_all" model="ir.rule">
        <field name="name">Administrators: All BoQs</field>
        <field name="model_id" ref="model_client_bill_of_quantity"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bill_of_quantity_line_admin_all" model="ir.rule">
        <field name="name">Administrators: All BoQ Lines</field>
        <field name="model_id" ref="model_client_bill_of_quantity_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_bill_of_quantity_history_admin_all" model="ir.rule">
        <field name="name">Administrators: All BoQ History</field>
        <field name="model_id" ref="model_client_bill_of_quantity_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
